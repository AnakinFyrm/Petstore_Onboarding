# Environment variables for pet-mcp
# pet-mcp 的环境变量
# Copy this file to .env and fill in your values.
# 把这个文件复制成 .env,然后按你自己的实际值填写。

# Base URL of the petstore-api instance this MCP server talks to.
# Defaults to http://localhost:8000 if unset (see src/pet_mcp/server.py).
# 这个 MCP 服务器要访问的 petstore-api 实例的地址。
# 如果不设置,默认是 http://localhost:8000(见 src/pet_mcp/server.py)。
PETSTORE_API_BASE_URL=http://localhost:8000
