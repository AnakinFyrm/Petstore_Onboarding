{
  "name": "pet-aes",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.14-bookworm",
  "runArgs": [
    "--userns=keep-id"
  ],
  "features": {},
  "containerEnv": {
    "UV_CACHE_DIR": "/home/vscode/.cache/uv",
    "UV_LINK_MODE": "copy"
  },
  "mounts": [
    "source=pet-aes-uv-cache,target=/home/vscode/.cache/uv,type=volume"
  ],
  "postCreateCommand": "./.devcontainer/postCreateCommand.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "python.testing.pytestArgs": [
          "tests"
        ],
        "python.testing.unittestEnabled": false,
        "python.testing.pytestEnabled": true,
        "python.defaultInterpreterPath": "/workspaces/pet-aes/.venv/bin/python",
        "python.testing.pytestPath": "/workspaces/pet-aes/.venv/bin/pytest"
      }
    }
  }
}
