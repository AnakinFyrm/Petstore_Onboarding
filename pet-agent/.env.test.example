# pet-agent — TEST profile template.
#
# Copy to `.env.test` (gitignored) and fill in the secrets. Loaded when
# APP_ENV=test, layered ON TOP of .env.shared. Only keys that are secret or
# that differ between environments belong here; shared, non-secret defaults
# live in .env.shared. See .env.example for the full variable reference.

# LLM — test credentials. Keep LLM_BACKEND=none if the test environment
# should never make live LLM calls.
LLM_BACKEND=none
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Database — test Postgres. NEVER point this at the production database.
# Percent-encode special chars in the password (a literal '%' becomes '%25').
PG_DSN=

# Override shared defaults here when the test profile needs it, e.g.:
# LOG_LEVEL=DEBUG

# Telemetry: with no token nothing is configured and nothing leaves the process.
LOGFIRE_TOKEN=
