# pet-agent — shared, non-secret defaults (COMMITTED).
#
# Loaded for every APP_ENV, at the lowest priority: the profile file
# (.env.$APP_ENV) overrides anything here, and the real process environment
# overrides everything. A personal .env is never read. Keep ONLY non-secret,
# environment-independent values in this file — credentials and anything that
# differs between test and production belong in the per-environment profile
# (.env.test / .env.production), which are gitignored. See .env.test.example
# for the profile template and .env.example for the full variable reference.

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Fail-closed default: no LLM calls until a profile selects a real backend.
# Credentials and model selection live in the profile files.
LLM_BACKEND=none
