# pet-agent — environment variable reference (COMMITTED, values are examples).
#
# This file is documentation: it lists every variable the service understands.
# It is never loaded. Non-secret cross-profile defaults live in .env.shared;
# secrets and environment-specific values go into the gitignored profile files
# (copy .env.test.example to .env.test, .env.production.example to
# .env.production). The process environment overrides everything.

# Application profile: dev | test | production. Selects which .env.$APP_ENV
# profile file is loaded, so it must be set in the process environment itself,
# never inside a dotenv file.
APP_ENV=dev

# Logging
LOG_LEVEL=INFO
# text for humans, json for log aggregators
LOG_FORMAT=text

# Identifies this process in logs and telemetry. Override when several
# deployments of the same code must be told apart.
SERVICE_NAME=pet-agent

# Telemetry (Pydantic Logfire). Token-gated: with no token nothing is configured
# and nothing leaves the process. Set TELEMETRY_ENABLED=false to force it off
# even when a token is present.
TELEMETRY_ENABLED=true
LOGFIRE_TOKEN=

# LLM provider: anthropic | openai | openai_compat | azure | none.
# With "none" (or missing provider config) the LLM is disabled; the service
# logs a warning instead of crashing.
LLM_BACKEND=none
LLM_MODEL=

# Provider credentials (secrets, set in a profile file). Only the block for
# the selected backend is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL is only used by the openai_compat backend
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# To use OpenRouter, set LLM_BACKEND=openai_compat, then put the OpenRouter
# key in OPENAI_API_KEY, this URL in OPENAI_BASE_URL, and an OpenRouter model
# id in LLM_MODEL, e.g.:
#   LLM_BACKEND=openai_compat
#   OPENAI_API_KEY=<your OpenRouter key>
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=z-ai/glm-5.3-flash
# 要用 OpenRouter,把 LLM_BACKEND 设为 openai_compat,再把 OpenRouter 的密钥填进
# OPENAI_API_KEY、这个网址填进 OPENAI_BASE_URL、一个 OpenRouter 模型 id 填进
# LLM_MODEL,例子见上面几行注释。

# The pet-mcp project this agent launches as a subprocess and talks to over
# MCP (stdio). Relative paths are resolved against this process's working
# directory; point it at wherever your pet-mcp checkout actually lives.
# 本 agent 会把这个路径指向的 pet-mcp 项目当作子进程启动,并通过 MCP(stdio)
# 跟它对话。相对路径是相对于本进程的工作目录解析的;把它指向你本地 pet-mcp
# 检出的真实位置。
PET_MCP_PROJECT_DIR=../pet-mcp

# Passed straight through to the pet-mcp subprocess as its own
# PETSTORE_API_BASE_URL; this process never talks to petstore-api directly.
# 原样透传给 pet-mcp 子进程,作为它自己的 PETSTORE_API_BASE_URL;这个进程自己
# 从不直接跟 petstore-api 通信。
PETSTORE_API_BASE_URL=http://localhost:8000

# PostgreSQL DSN, e.g. postgresql://user:password@host:5432/dbname
# (secret, set in a profile file). Percent-encode special characters in the
# password (a literal '%' becomes '%25').
PG_DSN=

# Pool sizing
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=5
# A container often starts before the database accepts connections, so the first
# connection is retried instead of crashing the process.
PG_CONNECT_ATTEMPTS=10
PG_CONNECT_BACKOFF_SECONDS=1.0

# Gate for the Postgres integration tests: when set, tests that need a live
# database run against it. Point it ONLY at a disposable test database.
TEST_DATABASE_URL=
