# Top-level .env template for the full Petstore stack (docker-compose.yml in
# this same directory). Copy this to .env (already gitignored - see
# .gitignore) and fill in your real values; .env itself is never read by git,
# never baked into any image (see .dockerignore), and is only ever loaded by
# `docker compose` at container-start time via the pet-agent service's
# env_file entry.
#
# 这是给完整 Petstore 环境用的顶层 .env 模板(跟它同目录的
# docker-compose.yml)。把它复制成 .env(已经在 .gitignore 里排除了 - 见
# .gitignore),然后填入你自己真实的值;.env 本身不会被 git 提交,也不会被打
# 进任何镜像(见 .dockerignore),只会在容器启动时被 `docker compose` 通过
# pet-agent 这个 service 的 env_file 读取。

# dev | test | production - selects which pet-agent/.env.$APP_ENV profile
# pet-agent's own config loader would use if one existed; for this stack the
# real values below are supplied directly as environment variables instead,
# so this mostly just labels the deployment in logs/telemetry.
APP_ENV=dev

# Fill in your own OpenRouter (or other openai_compat-style) credentials
# below - leave this file's copy (.env.example) itself alone; put real values
# only in your own .env.
LLM_BACKEND=openai_compat
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# <- put your own OpenRouter key here, in .env only, never in .env.example
OPENAI_API_KEY=key
LLM_MODEL=z-ai/glm-5.3-flash
